# ==========================================
# AI短剧多智能体 - 音视频生成引擎配置
# 复制本文件为 .env 并填入你使用的平台密钥
# ==========================================

# 选择启用的引擎：mock（干跑测试） | jimeng（即梦） | kling（可灵） | bailian（阿里百炼） | local（本地部署）
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock

# --- 1. 阿里百炼 (DashScope / 通义万相) ---
BAILIAN_API_KEY=sk-xxxx
BAILIAN_IMAGE_MODEL=wanx2.1-t2i-turbo
BAILIAN_VIDEO_MODEL=wanx2.1-i2v-turbo

# --- 2. 可灵 (Kling AI) ---
# 鉴权：AK/SK 会在代码里签成 HS256 JWT，不是直接用 AK 当 token
KLING_ACCESS_KEY=your_kling_ak
KLING_SECRET_KEY=your_kling_sk
KLING_API_BASE=https://api.klingai.com
KLING_IMAGE_MODEL=kling-v1
KLING_VIDEO_MODEL=kling-v1

# --- 3. 即梦 (火山引擎 / Volcengine) ---
# 官方视觉 API 用 AK/SK 做 HMAC-SHA256 签名；只填 API_KEY 时走 Bearer，仅适用于自建中转
JIMENG_ACCESS_KEY=your_volc_ak
JIMENG_SECRET_KEY=your_volc_sk
JIMENG_API_KEY=your_volc_api_key
JIMENG_API_BASE=https://visual.volcengineapi.com
JIMENG_API_VERSION=2022-08-31
JIMENG_IMAGE_REQ_KEY=jimeng_high_aes_general_v21
JIMENG_VIDEO_REQ_KEY=jimeng_vgfm_i2v_l20
JIMENG_IMAGE_MODEL=jimeng_high_aes_general_v21
JIMENG_VIDEO_MODEL=jimeng_vgfm_i2v_l20


# --- 4. 本地部署模型 (ComfyUI / FastAPI / Gradio) ---
LOCAL_IMAGE_ENDPOINT=http://127.0.0.1:8188/api/generate_image
LOCAL_VIDEO_ENDPOINT=http://127.0.0.1:8188/api/generate_video
LOCAL_API_TOKEN=
